<Window x:Class="MelTime.ClientWindows.Dialogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelTime"
        Width="460"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI" FontSize="13"
        KeyDown="Fenetre_KeyDown">

    <Border Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Bordure}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="26,22"
            MouseLeftButtonDown="ZoneDeplacement_MouseLeftButtonDown">

        <StackPanel>

            <TextBlock x:Name="Titre"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Texte}" />

            <TextBlock x:Name="Message"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Foreground="{StaticResource TexteSecondaire}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button x:Name="BoutonAnnuler"
                        Content="Annuler"
                        Width="110" Height="36"
                        Margin="0,0,10,0"
                        Background="{StaticResource SurfaceActive}"
                        Foreground="{StaticResource Texte}"
                        Visibility="Collapsed"
                        Click="Annuler_Click" />

                <Button x:Name="BoutonValider"
                        Content="D'accord"
                        Width="120" Height="36"
                        Style="{StaticResource BoutonAccent}"
                        IsDefault="True"
                        Click="Valider_Click" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
