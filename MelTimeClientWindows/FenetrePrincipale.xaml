<Window x:Class="MelTime.ClientWindows.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelTime"
        Height="680" Width="1040"
        MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             En-tête : navigation entre les semaines
             ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BoutonPrecedent" Width="38" Height="30"
                        Style="{StaticResource BoutonFantome}"
                        ToolTip="Semaine précédente" Click="BoutonPrecedent_Click">
                    <Path Data="M 7 0 L 0 8 L 7 16 Z"
                          Fill="{StaticResource Accent}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <ComboBox x:Name="ChoixAnnee" Grid.Column="1" Width="86" Margin="10,0,0,0"
                          SelectionChanged="ChoixAnnee_SelectionChanged" />

                <ComboBox x:Name="ChoixSemaine" Grid.Column="2" Width="170" Margin="8,0,0,0"
                          SelectionChanged="ChoixSemaine_SelectionChanged" />

                <Button x:Name="BoutonAujourdhui" Grid.Column="3" Content="Aujourd'hui"
                        Margin="8,0,0,0" Click="BoutonAujourdhui_Click" />

                <Button x:Name="BoutonSuivant" Grid.Column="4" Width="38" Height="30"
                        Style="{StaticResource BoutonFantome}" Margin="6,0,0,0"
                        ToolTip="Semaine suivante" Click="BoutonSuivant_Click">
                    <Path Data="M 0 0 L 7 8 L 0 16 Z"
                          Fill="{StaticResource Accent}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TexteUtilisateur" VerticalAlignment="Center" Margin="0,0,16,0"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentSurvol}" />
                    <Button Content="Se déconnecter"
                            Style="{StaticResource BoutonDanger}"
                            Height="32"
                            Click="BoutonDeconnexion_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Contrat de la semaine et message d'état
             ============================================================ -->
        <Grid Grid.Row="1" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Contrat :" VerticalAlignment="Center"
                       Foreground="{StaticResource TexteSecondaire}" />

            <ComboBox x:Name="ChoixContratHeures" Grid.Column="1" Width="62" Margin="8,0,0,0"
                      SelectionChanged="Contrat_Modifie" />

            <TextBlock Grid.Column="2" Text="h" VerticalAlignment="Center" Margin="6,0,10,0"
                       Foreground="{StaticResource TexteSecondaire}" />

            <ComboBox x:Name="ChoixContratMinutes" Grid.Column="3" Width="66"
                      SelectionChanged="Contrat_Modifie" />

            <TextBlock Grid.Column="4" Text="min" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource TexteSecondaire}" />

            <TextBlock x:Name="TexteStatut" Grid.Column="5" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Foreground="{StaticResource TexteSecondaire}" />
        </Grid>

        <!-- ============================================================
             Bandeau d'erreur intégré (remplace les MessageBox bloquantes)
             ============================================================ -->
        <Border x:Name="BandeauErreur" Grid.Row="2" Visibility="Collapsed"
                Background="#26FF5B5B" BorderBrush="{StaticResource Erreur}" BorderThickness="3,0,0,0"
                CornerRadius="4" Margin="16,6,16,0" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TexteBandeau" Foreground="{StaticResource Erreur}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />

                <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource BoutonFantome}"
                        Foreground="{StaticResource Erreur}" Padding="8,0" Margin="12,0,0,0"
                        ToolTip="Fermer" Click="BoutonFermerBandeau_Click" />
            </Grid>
        </Border>

        <!-- ============================================================
             Grille des sept jours, construite par le code
             ============================================================ -->
        <Border Grid.Row="3" Margin="16,10" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}" BorderThickness="1">
            <Grid x:Name="GrilleJours" />
        </Border>

        <!-- ============================================================
             Pied : totaux et enregistrement
             ============================================================ -->
        <Grid Grid.Row="4" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total semaine" VerticalAlignment="Bottom" Margin="0,0,10,3"
                           Foreground="{StaticResource TexteSecondaire}" />
                <TextBlock x:Name="TexteTotal" Text="00:00" FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" />
            </StackPanel>

            <TextBlock x:Name="TexteSupplementaires" Grid.Column="1" VerticalAlignment="Bottom"
                       Margin="28,0,0,6" Foreground="{StaticResource TexteSecondaire}" />

            <Button x:Name="BoutonActualiser" Grid.Column="3" Content="Recharger"
                    Style="{StaticResource BoutonAccent}" Width="150" Height="38" Margin="0,0,10,0"
                    Click="BoutonActualiser_Click" />

            <Button x:Name="BoutonEnregistrer" Grid.Column="4" Content="Enregistrer"
                    Style="{StaticResource BoutonAccent}" Width="150" Height="38"
                    IsEnabled="False" Click="BoutonEnregistrer_Click" />
        </Grid>
    </Grid>
</Window>
