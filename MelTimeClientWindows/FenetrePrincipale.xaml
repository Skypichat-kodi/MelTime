<Window x:Class="MelTime.ClientWindows.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelTime"
        Height="620" Width="1000"
        MinHeight="540" MinWidth="860"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de navigation entre les semaines -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BoutonPrecedent" Content="&#x25C0;" Width="34" Height="26"
                    ToolTip="Semaine précédente" Click="BoutonPrecedent_Click" />

            <ComboBox x:Name="ChoixAnnee" Grid.Column="1" Width="80" Height="26" Margin="8,0,0,0"
                      SelectionChanged="ChoixAnnee_SelectionChanged" />

            <ComboBox x:Name="ChoixSemaine" Grid.Column="2" Width="170" Height="26" Margin="6,0,0,0"
                      SelectionChanged="ChoixSemaine_SelectionChanged" />

            <Button x:Name="BoutonAujourdhui" Grid.Column="3" Content="Semaine en cours" Height="26"
                    Padding="10,0" Margin="6,0,0,0" Click="BoutonAujourdhui_Click" />

            <Button x:Name="BoutonSuivant" Grid.Column="4" Content="&#x25B6;" Width="34" Height="26"
                    Margin="6,0,0,0" ToolTip="Semaine suivante" Click="BoutonSuivant_Click" />

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TexteUtilisateur" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="#666666" />
                <Button Content="Se déconnecter" Height="26" Padding="10,0" Click="BoutonDeconnexion_Click" />
            </StackPanel>
        </Grid>

        <!-- Contrat de la semaine et message d'etat -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Contrat de la semaine :" VerticalAlignment="Center" />

            <ComboBox x:Name="ChoixContratHeures" Grid.Column="1" Width="60" Height="26" Margin="8,0,0,0"
                      SelectionChanged="Contrat_Modifie" />

            <TextBlock Grid.Column="2" Text="h" VerticalAlignment="Center" Margin="4,0,8,0" />

            <ComboBox x:Name="ChoixContratMinutes" Grid.Column="3" Width="64" Height="26"
                      SelectionChanged="Contrat_Modifie" />

            <TextBlock Grid.Column="4" Text="min" VerticalAlignment="Center" Margin="4,0,0,0" />

            <TextBlock x:Name="TexteStatut" Grid.Column="5" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Foreground="#666666" />
        </Grid>

        <!-- Grille des sept jours, construite par le code -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1,1,0,0" Background="White">
            <Grid x:Name="GrilleJours" />
        </Border>

        <!-- Totaux et enregistrement -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TexteTotal" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="Total semaine : 00:00" />

            <TextBlock x:Name="TexteSupplementaires" Grid.Column="1" Margin="24,0,0,0"
                       VerticalAlignment="Center" Foreground="#666666" />

            <Button x:Name="BoutonEnregistrer" Grid.Column="2" Content="Enregistrer" Width="130" Height="32"
                    IsEnabled="False" Click="BoutonEnregistrer_Click" />

            <Button x:Name="BoutonActualiser" Grid.Column="3" Content="Recharger" Width="110" Height="32"
                    Margin="8,0,0,0" Click="BoutonActualiser_Click" />
        </Grid>
    </Grid>
</Window>
