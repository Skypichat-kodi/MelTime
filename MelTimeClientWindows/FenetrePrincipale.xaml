<Window x:Class="MelTime.ClientWindows.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelTime"
        Height="480" Width="820"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TexteBienvenue" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock x:Name="TexteContrat" Margin="0,8,0,0" Foreground="#666666" HorizontalAlignment="Center" />
            <TextBlock Text="La feuille de temps sera ajoutée à l'étape suivante."
                       Margin="0,24,0,0" Foreground="#666666" HorizontalAlignment="Center" />
            <Button Content="Se déconnecter"
                    Margin="0,28,0,0"
                    Padding="18,8"
                    HorizontalAlignment="Center"
                    Click="BoutonDeconnexion_Click" />
        </StackPanel>
    </Grid>
</Window>
