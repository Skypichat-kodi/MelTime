<Window x:Class="MelTime.ClientWindows.FenetrePrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MelTime"
        Icon="/app.ico"
        Height="880" Width="1200"
        MinHeight="800" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI" FontSize="13">

    <!-- WindowChrome plutot que la transparence : la feuille de temps doit
         rester redimensionnable (sept jours sur cinq colonnes), ce que
         AllowsTransparency interdit. Le cadre reste celui de Windows pour le
         redimensionnement, la barre de titre est simplement la notre. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Seule la grille des jours s'etire : les totaux, les salaires
                 et les boutons gardent leur hauteur naturelle, sinon ils se
                 chevauchent quand la fenetre est reduite. -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             En-tête : navigation entre les semaines
             ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="EnTete_MouseLeftButtonDown">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BoutonPrecedent" Width="38" Height="30"
                        Style="{StaticResource BoutonFantome}"
                        ToolTip="Semaine précédente" Click="BoutonPrecedent_Click">
                    <Path Data="M 7 0 L 0 8 L 7 16 Z"
                          Fill="{StaticResource Accent}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <ComboBox x:Name="ChoixAnnee" Grid.Column="1" Width="86" Margin="10,0,0,0"
                          SelectionChanged="ChoixAnnee_SelectionChanged" />

                <ComboBox x:Name="ChoixSemaine" Grid.Column="2" Width="170" Margin="8,0,0,0"
                          SelectionChanged="ChoixSemaine_SelectionChanged" />

                <Button x:Name="BoutonAujourdhui" Grid.Column="3" Content="Aujourd'hui"
                        Margin="8,0,0,0" Click="BoutonAujourdhui_Click" />

                <Button x:Name="BoutonSuivant" Grid.Column="4" Width="38" Height="30"
                        Style="{StaticResource BoutonFantome}" Margin="6,0,0,0"
                        ToolTip="Semaine suivante" Click="BoutonSuivant_Click">
                    <Path Data="M 0 0 L 7 8 L 0 16 Z"
                          Fill="{StaticResource Accent}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TexteUtilisateur" VerticalAlignment="Center" Margin="0,0,16,0"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentSurvol}" />
                    <Button Content="Se déconnecter"
                            Style="{StaticResource BoutonDanger}"
                            Height="32"
                            Click="BoutonDeconnexion_Click" />
                </StackPanel>

                <!-- Boutons de fenetre, a droite de l'en-tete -->
                <StackPanel Grid.Column="7" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="BoutonReduire"
                            Content="—"
                            Style="{StaticResource BoutonFantome}"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="Réduire"
                            Click="BoutonReduire_Click" />
                    <Button x:Name="BoutonFermer"
                            Content="✕"
                            Style="{StaticResource BoutonFantome}"
                            Width="32" Height="28" Padding="0" FontSize="13"
                            ToolTip="Fermer"
                            Click="BoutonFermer_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Contrat de la semaine et message d'état
             ============================================================ -->
        <Grid Grid.Row="1" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Contrat :" VerticalAlignment="Center"
                       Foreground="{StaticResource TexteSecondaire}" />

            <ComboBox x:Name="ChoixContratHeures" Grid.Column="1" Width="62" Margin="8,0,0,0"
                      SelectionChanged="Contrat_Modifie" />

            <TextBlock Grid.Column="2" Text="h" VerticalAlignment="Center" Margin="6,0,10,0"
                       Foreground="{StaticResource TexteSecondaire}" />

            <ComboBox x:Name="ChoixContratMinutes" Grid.Column="3" Width="66"
                      SelectionChanged="Contrat_Modifie" />

            <TextBlock Grid.Column="4" Text="min" VerticalAlignment="Center" Margin="6,0,0,0"
                       Foreground="{StaticResource TexteSecondaire}" />

            <!-- Date d'arrivee : les semaines anterieures ne comptent pas
                 dans le solde. -->
            <TextBlock Grid.Column="5" x:Name="TexteDebutContrat" VerticalAlignment="Center"
                       Margin="24,0,0,0" FontSize="12"
                       ToolTip="Premier jour du contrat : les semaines antérieures ne comptent pas dans le solde"
                       Foreground="{StaticResource TexteSecondaire}" />

            <TextBlock x:Name="TexteStatut" Grid.Column="6" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Foreground="{StaticResource TexteSecondaire}" />
        </Grid>

        <!-- ============================================================
             Bandeau d'erreur intégré (remplace les MessageBox bloquantes)
             ============================================================ -->
        <Border x:Name="BandeauErreur" Grid.Row="2" Visibility="Collapsed"
                Background="#26FF5B5B" BorderBrush="{StaticResource Erreur}" BorderThickness="3,0,0,0"
                CornerRadius="4" Margin="16,6,16,0" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TexteBandeau" Foreground="{StaticResource Erreur}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />

                <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource BoutonFantome}"
                        Foreground="{StaticResource Erreur}" Padding="8,0" Margin="12,0,0,0"
                        ToolTip="Fermer" Click="BoutonFermerBandeau_Click" />
            </Grid>
        </Border>

        <!-- ============================================================
             Grille des sept jours, construite par le code
             ============================================================ -->
        <Border Grid.Row="3" Margin="16,10" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}" BorderThickness="1">
            <Grid x:Name="GrilleJours" />
        </Border>
        <!-- ============================================================
             Salaire : deux montants saisis, et les valeurs qui en decoulent.

             Toutes les cellules partagent la meme structure et la meme hauteur
             de valeur (32 px), pour que saisies et resultats s'alignent.
             ============================================================ -->
        <Grid Grid.Row="5" Margin="16,0,16,10">

        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MinHeight="82"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="SALAIRE BRUT" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" />
                    <Grid Height="36" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBox x:Name="ChampSalaireBrut" Width="100" FontSize="16" Padding="6,4"
                                     TextAlignment="Right" VerticalContentAlignment="Center"
                                     TextChanged="ChampSalaire_TextChanged" />
                            <TextBlock Text="€" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="16"
                                       Foreground="{StaticResource TexteSecondaire}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Margin="0,2,20,2"
                        Background="{StaticResource Bordure}" />

                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Text="SALAIRE NET" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" />
                    <Grid Height="36" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBox x:Name="ChampSalaireNet" Width="100" FontSize="16" Padding="6,4"
                                     TextAlignment="Right" VerticalContentAlignment="Center"
                                     TextChanged="ChampSalaire_TextChanged" />
                            <TextBlock Text="€" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="16"
                                       Foreground="{StaticResource TexteSecondaire}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="3" Width="1" Margin="0,2,20,2"
                        Background="{StaticResource Bordure}" />

                <StackPanel Grid.Column="4" Margin="0,0,20,0">
                    <TextBlock Text="CHARGES" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" />
                    <Grid Height="36" Margin="0,2,0,0">
                        <TextBlock x:Name="TexteCharges" Text="—" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Erreur}" />
                    </Grid>
                </StackPanel>

                <Border Grid.Column="5" Width="1" Margin="0,2,20,2"
                        Background="{StaticResource Bordure}" />

                <StackPanel Grid.Column="6" Margin="0,0,20,0">
                    <TextBlock Text="PRIX / HEURE BRUT" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" />
                    <Grid Height="36" Margin="0,2,0,0">
                        <TextBlock x:Name="TextePrixBrut" Text="—" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}" />
                    </Grid>
                </StackPanel>

                <Border Grid.Column="7" Width="1" Margin="0,2,20,2"
                        Background="{StaticResource Bordure}" />

                <StackPanel Grid.Column="8" Margin="0,0,20,0">
                    <TextBlock Text="PRIX / HEURE NET" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TexteSecondaire}" />
                    <Grid Height="36" Margin="0,2,0,0">
                        <TextBlock x:Name="TextePrixNet" Text="—" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        </Grid>

        <!-- ============================================================
             Pied : totaux et enregistrement

             Les trois totaux forment un seul bloc encadre : meme taille de
             valeur, meme structure libelle/valeur, separateurs verticaux.
             Seule la couleur distingue le total de la semaine.
             ============================================================ -->
        <!-- ============================================================
             Tableau des totaux : trois periodes comparees au seuil de 35 h
             et au contrat, avec la difference qui en resulte. Les absences
             sont comptees a part des heures.
             ============================================================ -->
        <Border Grid.Row="4" Margin="16,10,16,10"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="#2E2E2E" Padding="14,7">
                    <TextBlock Text="PÉRIODE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="#2E2E2E" Padding="14,7"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="1,0,0,0">
                    <TextBlock Text="DIFFÉRENCE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}"
                               ToolTip="Heures supplémentaires moins heures manquantes" />
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="#2E2E2E" Padding="14,7"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="1,0,0,0">
                    <TextBlock Text="HEURES SUPPLÉMENTAIRES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Background="#2E2E2E" Padding="14,7"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="1,0,0,0">
                    <TextBlock Text="HEURES MANQUANTES" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}" />
                </Border>
                <Border Grid.Row="0" Grid.Column="4" Background="#2E2E2E" Padding="14,7"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="1,0,0,0">
                    <TextBlock Text="BRUT" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}"
                               ToolTip="Heures de la période multipliées par le taux horaire brut" />
                </Border>
                <Border Grid.Row="0" Grid.Column="5" Background="#2E2E2E" Padding="14,7"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="1,0,0,0">
                    <TextBlock Text="NET" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}"
                               ToolTip="Heures de la période multipliées par le taux horaire net" />
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Semaine" FontWeight="SemiBold" Foreground="{StaticResource Texte}" />
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteDiffSemaine" Text="—" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteSupSemaine" Text="—" Foreground="{StaticResource Accent}" />
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteManqueSemaine" Text="—" Foreground="{StaticResource Erreur}" />
                </Border>
                <Border Grid.Row="1" Grid.Column="4" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteBrutSemaine" Text="—" Foreground="{StaticResource Texte}" />
                </Border>
                <Border Grid.Row="1" Grid.Column="5" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteNetSemaine" Text="—" Foreground="{StaticResource Texte}" />
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Mois" FontWeight="SemiBold" Foreground="{StaticResource Texte}" />
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteDiffMois" Text="—" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteSupMois" Text="—" Foreground="{StaticResource Accent}" />
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteManqueMois" Text="—" Foreground="{StaticResource Erreur}" />
                </Border>
                <Border Grid.Row="2" Grid.Column="4" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteBrutMois" Text="—" Foreground="{StaticResource Texte}" />
                </Border>
                <Border Grid.Row="2" Grid.Column="5" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteNetMois" Text="—" Foreground="{StaticResource Texte}" />
                </Border>

                <Border Grid.Row="3" Grid.Column="0" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Année · 52 sem." FontWeight="SemiBold" Foreground="{StaticResource Texte}" />
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteDiffAn" Text="—" FontWeight="SemiBold" />
                </Border>
                <Border Grid.Row="3" Grid.Column="2" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteSupAn" Text="—" Foreground="{StaticResource Accent}"
                               ToolTip="Heures accomplies au-delà de 35 h, sur les 52 dernières semaines" />
                </Border>
                <Border Grid.Row="3" Grid.Column="3" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteManqueAn" Text="—" Foreground="{StaticResource Erreur}"
                               ToolTip="Heures manquantes par rapport au contrat, sur les 52 dernières semaines" />
                </Border>
                <Border Grid.Row="3" Grid.Column="4" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteBrutAn" Text="—" Foreground="{StaticResource Texte}" />
                </Border>
                <Border Grid.Row="3" Grid.Column="5" Padding="14,6"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteNetAn" Text="—" Foreground="{StaticResource Texte}" />
                </Border>

                <Border Grid.Row="4" Grid.Column="4" Background="#242424"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" />
                <Border Grid.Row="4" Grid.Column="5" Background="#242424"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" />

                <Border Grid.Row="4" Grid.Column="0" Padding="14,6" Background="#242424"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock Text="Congés payés" Foreground="{StaticResource TexteSecondaire}" />
                </Border>
                <Border Grid.Row="4" Grid.Column="1" Padding="14,6" Background="#242424"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="TexteConges" Text="—" Foreground="{StaticResource Texte}"
                               ToolTip="Jours de congés payés pris sur les 25 acquis" />
                </Border>
                <Border Grid.Row="4" Grid.Column="2" Background="#242424"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" />
                <Border Grid.Row="4" Grid.Column="3" Background="#242424"
                        BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0" />

                <Border Grid.Row="5" Grid.Column="0" Padding="14,6" Background="#242424">
                    <TextBlock Text="Arrêt maladie" Foreground="{StaticResource TexteSecondaire}" />
                </Border>
                <Border Grid.Row="5" Grid.Column="1" Padding="14,6" Background="#242424">
                    <TextBlock x:Name="TexteMaladie" Text="—" Foreground="{StaticResource Erreur}"
                               ToolTip="Jours d'arrêt maladie sur les 52 dernières semaines" />
                </Border>
                <Border Grid.Row="5" Grid.Column="2" Background="#242424" />
                <Border Grid.Row="5" Grid.Column="3" Background="#242424" />
                <Border Grid.Row="5" Grid.Column="4" Background="#242424" />
                <Border Grid.Row="5" Grid.Column="5" Background="#242424" />

                <!-- Salaire moyen mensuel : le montant annuel reparti sur douze mois -->
                <Border Grid.Row="6" Grid.ColumnSpan="6" Padding="14,8">
                    <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TexteSecondaire}"
                               ToolTip="Montant de l'année divisé par douze, brut et net">
                        <Run Text="Salaire moyen mensuel : " />
                        <Run x:Name="RunSalaireBrut" />
                        <Run x:Name="RunSalaireNet"
                             Foreground="{StaticResource Accent}" FontWeight="Bold" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             Boutons d'action, sous les totaux
             ============================================================ -->
        <Grid Grid.Row="6" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BoutonHorairesDefaut" Grid.Column="1" Content="Calendriers par défaut"
                    Style="{StaticResource BoutonSecondaire}" Width="210" Height="38" Margin="0,0,10,0"
                    VerticalAlignment="Center" Click="BoutonHorairesDefaut_Click" />

            <Button x:Name="BoutonActualiser" Grid.Column="2" Content="Recharger"
                    Style="{StaticResource BoutonAccent}" Width="150" Height="38" Margin="0,0,10,0"
                    VerticalAlignment="Center" Click="BoutonActualiser_Click" />

            <Button x:Name="BoutonEnregistrer" Grid.Column="3" Content="Enregistrer"
                    Style="{StaticResource BoutonAccent}" Width="150" Height="38"
                    VerticalAlignment="Center" IsEnabled="False" Click="BoutonEnregistrer_Click" />
        </Grid>
    </Grid>
</Window>
