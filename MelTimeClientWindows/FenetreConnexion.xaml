<Window x:Class="MelTime.ClientWindows.FenetreConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelTime"
        Icon="/app.ico"
        Height="520" Width="520"
        MinHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        KeyDown="Fenetre_KeyDown"
        Background="Transparent"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid>
        <!-- Halo discret en haut, pour éviter un fond totalement plat -->
        <Rectangle Height="200" VerticalAlignment="Top">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1.2">
                    <GradientStop Color="#2A0078D4" Offset="0" />
                    <GradientStop Color="#000078D4" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Bordure}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28,26"
                MouseLeftButtonDown="ZoneDeplacement_MouseLeftButtonDown">

            <Grid>

            <StackPanel>

                <TextBlock Text="MelTime" Style="{StaticResource Titre}" />
                <TextBlock Text="Feuille de temps hebdomadaire"
                           Foreground="{StaticResource TexteSecondaire}"
                           Margin="0,2,0,24" />

                <TextBlock Text="Serveur" Style="{StaticResource Libelle}" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ChampHote"
                             ToolTip="Adresse IP ou nom du serveur" />

                    <!-- Invite affichee tant que le champ est vide : WPF n'en
                         propose pas nativement. -->
                    <TextBlock x:Name="InviteHote"
                               Text="IP ou domaine"
                               Foreground="{StaticResource TexteSecondaire}"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />

                    <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center"
                               Margin="8,0" Foreground="{StaticResource TexteSecondaire}" />

                    <TextBox x:Name="ChampPort" Grid.Column="2" Width="76"
                             ToolTip="Port d'écoute du service, 5080 par défaut" />
                </Grid>

                <TextBlock Text="Identifiant" Style="{StaticResource Libelle}" />
                <TextBox x:Name="ChampIdentifiant" Margin="0,0,0,16" />

                <TextBlock Text="Mot de passe" Style="{StaticResource Libelle}" />

                <Grid Margin="0,0,0,8">
                    <PasswordBox x:Name="ChampMotDePasse"
                                 PasswordChanged="ChampMotDePasse_PasswordChanged" />
                    <TextBox x:Name="ChampMotDePasseVisible"
                             Visibility="Collapsed"
                             TextChanged="ChampMotDePasseVisible_TextChanged" />
                </Grid>

                <CheckBox x:Name="CaseAfficherMotDePasse"
                          Content="Afficher le mot de passe"
                          Margin="0,0,0,16"
                          Checked="CaseAfficher_Change"
                          Unchecked="CaseAfficher_Change" />

                <Border x:Name="CadreErreur"
                        Visibility="Collapsed"
                        Background="#26FF5B5B"
                        BorderBrush="{StaticResource Erreur}"
                        BorderThickness="1,0,0,0"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="TexteErreur"
                               Foreground="{StaticResource Erreur}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>

                <Button x:Name="BoutonConnexion"
                        Content="Se connecter"
                        Style="{StaticResource BoutonAccent}"
                        Height="38"
                        IsDefault="True"
                        Click="BoutonConnexion_Click" />

            </StackPanel>

                <!-- Croix de fermeture : la fenetre n'a plus de barre de
                     titre Windows, c'est elle qui permet de la fermer. -->
                <Button x:Name="BoutonFermer"
                        Content="✕"
                        Style="{StaticResource BoutonFantome}"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-14,-14,0"
                        FontSize="13"
                        Padding="0"
                        ToolTip="Fermer"
                        Click="BoutonFermer_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
