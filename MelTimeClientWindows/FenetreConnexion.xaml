<Window x:Class="MelTime.ClientWindows.FenetreConnexion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelTime — Connexion"
        Height="420" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="28">

        <TextBlock Text="MelTime" FontSize="26" FontWeight="Light" Margin="0,0,0,4" />
        <TextBlock Text="Feuille de temps hebdomadaire" Foreground="#666666" Margin="0,0,0,22" />

        <TextBlock Text="Serveur" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ChampHote" Padding="6" ToolTip="Adresse IP ou nom du serveur, par exemple 192.168.1.10" />

            <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="6,0" />

            <TextBox x:Name="ChampPort" Grid.Column="2" Width="72" Padding="6" ToolTip="Port d'écoute du service, 5080 par défaut" />
        </Grid>

        <TextBlock Text="Identifiant" Margin="0,0,0,4" />
        <TextBox x:Name="ChampIdentifiant" Padding="6" Margin="0,0,0,14" />

        <TextBlock Text="Mot de passe" Margin="0,0,0,4" />
        <PasswordBox x:Name="ChampMotDePasse" Padding="6" Margin="0,0,0,16" />

        <TextBlock x:Name="TexteErreur"
                   Foreground="#C42B1C"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,12" />

        <Button x:Name="BoutonConnexion"
                Content="Se connecter"
                Height="34"
                IsDefault="True"
                Click="BoutonConnexion_Click" />

    </StackPanel>
</Window>
