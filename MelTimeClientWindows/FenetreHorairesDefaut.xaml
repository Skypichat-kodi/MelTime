<Window x:Class="MelTime.ClientWindows.FenetreHorairesDefaut"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Calendriers par défaut"
        Icon="/app.ico"
        Height="700" Width="860"
        MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource Fond}"
        Foreground="{StaticResource Texte}"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Meme cadre que la feuille de temps : pas de barre de titre Windows,
         mais le redimensionnement par les bords reste disponible. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Margin="16" MouseLeftButtonDown="ZoneDeplacement_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Calendriers par défaut" FontSize="20" FontWeight="Light"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1" x:Name="BoutonFermer" Content="✕"
                    Style="{StaticResource BoutonFantome}"
                    Width="32" Height="28" Padding="0" FontSize="13"
                    ToolTip="Fermer"
                    Click="BoutonFermerFenetre_Click" />
        </Grid>

        <!-- Point de depart du cycle -->
        <Grid Grid.Row="1" Margin="0,10,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Début du cycle" VerticalAlignment="Center"
                       Foreground="{StaticResource Texte}" />

            <!-- Listes plutot qu'un calendrier : on choisit une semaine de
                 travail, pas une date. L'annee reste necessaire, une semaine
                 3 n'ayant pas le meme lundi d'une annee a l'autre. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <ComboBox x:Name="ChoixAnnee" Width="86"
                          ToolTip="Année de la semaine de départ" />

                <ComboBox x:Name="ChoixSemaine" Width="150" Margin="8,0,0,0"
                          ToolTip="Semaine portant le premier modèle actif. « Aucune » applique le premier modèle partout." />
            </StackPanel>

            <TextBlock x:Name="TexteExplication" Grid.Column="2" Margin="18,0,0,0"
                       VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TexteSecondaire}" />
        </Grid>

        <!-- Un onglet par modele -->
        <TabControl x:Name="Onglets" Grid.Row="2"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Bordure}"
                    BorderThickness="1" />

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TexteStatut" VerticalAlignment="Center"
                       Foreground="{StaticResource TexteSecondaire}" />

            <Button x:Name="BoutonAnnuler" Grid.Column="1" Content="Annuler"
                    Width="130" Height="38" Margin="0,0,10,0"
                    Click="BoutonAnnuler_Click" />

            <Button x:Name="BoutonEnregistrer" Grid.Column="2" Content="Enregistrer"
                    Style="{StaticResource BoutonAccent}" Width="150" Height="38"
                    Click="BoutonEnregistrer_Click" />
        </Grid>
    </Grid>
</Window>
