<UserControl x:Class="MelTime.ClientWindows.SelecteurHeure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="28" MinWidth="86">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Champ"
                 VerticalContentAlignment="Center"
                 Padding="6,0"
                 MaxLength="5"
                 LostFocus="Champ_LostFocus"
                 KeyDown="Champ_KeyDown" />

        <Grid Grid.Column="1" Width="20" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Triangles dessines plutot que des caracteres : rendu net,
                 taille et couleur parfaitement maitrisees. -->
            <Button x:Name="BoutonPlus"
                    Style="{StaticResource BoutonFantome}"
                    Padding="0"
                    Focusable="False"
                    ToolTip="Ajouter 15 minutes"
                    Click="BoutonPlus_Click">
                <Path Data="M 0 5 L 5 0 L 10 5 Z"
                      Fill="{StaticResource Accent}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>

            <Button x:Name="BoutonMoins"
                    Grid.Row="1"
                    Style="{StaticResource BoutonFantome}"
                    Padding="0"
                    Focusable="False"
                    ToolTip="Retirer 15 minutes"
                    Click="BoutonMoins_Click">
                <Path Data="M 0 0 L 10 0 L 5 5 Z"
                      Fill="{StaticResource Accent}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
