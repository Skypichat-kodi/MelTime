<UserControl x:Class="MelTime.ClientWindows.SelecteurHeure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26" MinWidth="72">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="Champ"
                 VerticalContentAlignment="Center"
                 Padding="4,0"
                 MaxLength="5"
                 LostFocus="Champ_LostFocus"
                 KeyDown="Champ_KeyDown" />

        <Grid Grid.Column="1" Width="18" Margin="2,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="BoutonPlus"
                    Content="&#x25B2;"
                    FontSize="5"
                    Padding="0"
                    Focusable="False"
                    ToolTip="Ajouter 15 minutes"
                    Click="BoutonPlus_Click" />

            <Button x:Name="BoutonMoins"
                    Grid.Row="1"
                    Content="&#x25BC;"
                    FontSize="5"
                    Padding="0"
                    Focusable="False"
                    ToolTip="Retirer 15 minutes"
                    Click="BoutonMoins_Click" />
        </Grid>
    </Grid>
</UserControl>
