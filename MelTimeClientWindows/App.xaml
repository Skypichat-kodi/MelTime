<Application x:Class="MelTime.ClientWindows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ============================================================
             Palette sombre, proche de Windows 11, accent bleu profond.
             Le bleu est volontairement soutenu : le texte des boutons est blanc,
             et il doit rester nettement lisible par-dessus.
             ============================================================ -->
        <Color x:Key="CouleurFond">#FF1B1B1B</Color>
        <Color x:Key="CouleurSurface">#FF262626</Color>
        <Color x:Key="CouleurSurfaceSurvol">#FF303030</Color>
        <Color x:Key="CouleurSurfaceActive">#FF3A3A3A</Color>
        <Color x:Key="CouleurBordure">#FF3D3D3D</Color>
        <Color x:Key="CouleurTexte">#FFF2F2F2</Color>
        <Color x:Key="CouleurTexteSecondaire">#FFA0A0A0</Color>
        <Color x:Key="CouleurAccent">#FF0078D4</Color>
        <Color x:Key="CouleurAccentSurvol">#FF1B8AE0</Color>
        <Color x:Key="CouleurAccentPresse">#FF0067B8</Color>
        <Color x:Key="CouleurSucces">#FF3FB950</Color>
        <Color x:Key="CouleurErreur">#FFFF5B5B</Color>
        <Color x:Key="CouleurErreurSurvol">#FFFF7A7A</Color>
        <Color x:Key="CouleurErreurPresse">#FFE04545</Color>

        <SolidColorBrush x:Key="Fond" Color="{StaticResource CouleurFond}" />
        <SolidColorBrush x:Key="Surface" Color="{StaticResource CouleurSurface}" />
        <SolidColorBrush x:Key="SurfaceSurvol" Color="{StaticResource CouleurSurfaceSurvol}" />
        <SolidColorBrush x:Key="SurfaceActive" Color="{StaticResource CouleurSurfaceActive}" />
        <SolidColorBrush x:Key="Bordure" Color="{StaticResource CouleurBordure}" />
        <SolidColorBrush x:Key="Texte" Color="{StaticResource CouleurTexte}" />
        <SolidColorBrush x:Key="TexteSecondaire" Color="{StaticResource CouleurTexteSecondaire}" />
        <SolidColorBrush x:Key="Accent" Color="{StaticResource CouleurAccent}" />
        <SolidColorBrush x:Key="AccentSurvol" Color="{StaticResource CouleurAccentSurvol}" />
        <SolidColorBrush x:Key="AccentPresse" Color="{StaticResource CouleurAccentPresse}" />
        <SolidColorBrush x:Key="Succes" Color="{StaticResource CouleurSucces}" />
        <SolidColorBrush x:Key="Erreur" Color="{StaticResource CouleurErreur}" />
        <SolidColorBrush x:Key="ErreurSurvol" Color="{StaticResource CouleurErreurSurvol}" />
        <SolidColorBrush x:Key="ErreurPresse" Color="{StaticResource CouleurErreurPresse}" />

        <!-- ============================================================
             Fenêtre

             ATTENTION : un style implicite TargetType="Window" ne s'applique
             PAS aux fenetres derivees (FenetreConnexion, FenetrePrincipale).
             WPF ne l'applique qu'au type exact. Chaque fenetre doit donc
             declarer explicitement Background et Foreground.

             Pas de style implicite TextBlock non plus : il s'appliquerait aux
             TextBlock generes a l'interieur des boutons et des listes,
             et ecraserait leur Foreground. L'heritage depuis la fenetre suffit.
             ============================================================ -->
        <!-- Libellé discret au-dessus d'un champ -->
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
        </Style>

        <!-- ============================================================
             Champ de saisie
             ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Barre de défilement

             Les barres systeme sont claires et epaisses : elles jurent sur fond
             sombre. Celle-ci est fine, discrete, et son pouce est bleu.
             ============================================================ -->
        <Style x:Key="PouceDefilement" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pouce"
                                Background="{StaticResource Accent}"
                                Opacity="0.55"
                                CornerRadius="3"
                                Margin="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pouce" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pouce" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PouceDefilement}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================
             Case a cocher
             ============================================================ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Case"
                                    Width="16" Height="16"
                                    CornerRadius="3"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Bordure}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Coche"
                                      Data="M 3 8 L 6.5 11.5 L 13 4"
                                      Stroke="{StaticResource Accent}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Case" Property="BorderBrush" Value="{StaticResource AccentSurvol}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Boutons
             ============================================================ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceSurvol}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton principal : bleu électrique -->
        <Style x:Key="BoutonAccent" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource AccentSurvol}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource AccentSurvol}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource AccentPresse}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire : contour discret, pour une action visible mais non principale -->
        <Style x:Key="BoutonSecondaire" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
        </Style>

        <!-- Bouton d'action destructive : fond rouge plein, comme les boutons accentues.
             Un template propre est indispensable : celui de BoutonAccent bascule
             sur des teintes bleues au survol et a l'appui. -->
        <Style x:Key="BoutonDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Erreur}" />
            <Setter Property="BorderBrush" Value="{StaticResource Erreur}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <!--
              Padding asymetrique : Segoe UI descend un peu sous sa ligne de base,
              ce qui fait paraitre le libelle trop bas. Deux pixels de moins en haut
              et deux de plus en bas le recentrent optiquement.
            -->
            <Setter Property="Padding" Value="14,5,14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cadre"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource ErreurSurvol}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource ErreurSurvol}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource ErreurPresse}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Bordure}" />
                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton discret, sans cadre visible au repos -->
        <Style x:Key="BoutonFantome" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
        </Style>

        <!-- ============================================================
             Liste déroulante
             ============================================================ -->
        <Style x:Key="ZoneListe" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Cadre"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Bordure}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Path x:Name="Fleche"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{StaticResource TexteSecondaire}"
                                  StrokeThickness="1.4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource SurfaceActive}" />
                                <Setter TargetName="Fleche" Property="Stroke" Value="{StaticResource Texte}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Fleche" Property="Stroke" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Cadre" Background="Transparent" CornerRadius="4" Margin="4,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource SurfaceActive}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cadre" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Texte}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Zone"
                                          Style="{StaticResource ZoneListe}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Bordure}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
