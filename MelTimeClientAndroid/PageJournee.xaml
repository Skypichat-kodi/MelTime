<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageJournee"
             BackgroundColor="{StaticResource MelFond}">

    <VerticalStackLayout Padding="16,12" Spacing="10" VerticalOptions="Center">

        <Label x:Name="Titre"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource MelTexte}"
               HorizontalOptions="Center" />

        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <CheckBox x:Name="CaseTravaillee" CheckedChanged="CaseTravaillee_Changed" />
            <Label Text="Journée travaillée" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" />

            <!-- Sur un telephone, on ne peut pas effacer une heure au clavier :
                 cette case est le seul moyen de declarer une journee continue. -->
            <CheckBox x:Name="CaseSansPause" Margin="20,0,0,0"
                      CheckedChanged="CaseSansPause_Changed" />
            <Label Text="Sans pause" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" />

            <!-- Arret maladie : la journee est payee au volume prevu, donc
                 sans manque par rapport au contrat. -->
            <CheckBox x:Name="CaseMaladie" Margin="20,0,0,0"
                      CheckedChanged="CaseMaladie_Changed" />
            <Label Text="Maladie" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" />

            <CheckBox x:Name="CaseConge" Margin="20,0,0,0"
                      CheckedChanged="CaseConge_Changed" />
            <Label Text="Congé payé" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" />
        </HorizontalStackLayout>

        <!-- Quatre horaires sur deux rangees : la page s'affiche en paysage,
             ou la hauteur est comptee. -->
        <Grid x:Name="ZoneHoraires"
              ColumnDefinitions="Auto,*,Auto,*"
              RowDefinitions="Auto,Auto"
              RowSpacing="8" ColumnSpacing="12"
              HorizontalOptions="Center">

            <Label Text="Arrivée" VerticalOptions="Center" TextColor="{StaticResource MelTexteSecondaire}" />
            <TimePicker x:Name="ChampArrivee" Grid.Column="1" Format="HH:mm" WidthRequest="130"
                        TextColor="{StaticResource MelTexte}" />

            <Label Grid.Column="2" Text="Pause début" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexteSecondaire}" />
            <TimePicker x:Name="ChampPauseDebut" Grid.Column="3" Format="HH:mm" WidthRequest="130"
                        TextColor="{StaticResource MelTexte}" />

            <Label Grid.Row="1" Text="Pause fin" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexteSecondaire}" />
            <TimePicker x:Name="ChampPauseFin" Grid.Row="1" Grid.Column="1" Format="HH:mm" WidthRequest="130"
                        TextColor="{StaticResource MelTexte}" />

            <Label Grid.Row="1" Grid.Column="2" Text="Départ" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexteSecondaire}" />
            <TimePicker x:Name="ChampDepart" Grid.Row="1" Grid.Column="3" Format="HH:mm" WidthRequest="130"
                        TextColor="{StaticResource MelTexte}" />

        </Grid>

        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,6,0,0">
            <Button Text="Annuler" WidthRequest="130" HeightRequest="46"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="Annuler_Clicked" />

            <Button Text="Valider" WidthRequest="130" HeightRequest="46"
                    BackgroundColor="{StaticResource MelAccent}" TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Valider_Clicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>
