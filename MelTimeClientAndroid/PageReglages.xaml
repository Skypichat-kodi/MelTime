<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageReglages"
             BackgroundColor="{StaticResource MelFond}">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

            <Label Text="Mes salaires"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{StaticResource MelTexte}"
                   HorizontalOptions="Center" />

            <Label Text="Ces montants restent sur votre compte et ne sont visibles par personne d'autre."
                   FontSize="12"
                   TextColor="{StaticResource MelTexteSecondaire}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,8" />

            <Label Text="Salaire brut mensuel (€)" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />
            <Entry x:Name="ChampBrut"
                   Keyboard="Numeric"
                   TextChanged="Champ_TextChanged"
                   BackgroundColor="{StaticResource MelSurface}"
                   TextColor="{StaticResource MelTexte}"
                   PlaceholderColor="{StaticResource MelTexteSecondaire}"
                   Placeholder="2500" />

            <Label Text="Salaire net mensuel (€)" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />
            <Entry x:Name="ChampNet"
                   Keyboard="Numeric"
                   TextChanged="Champ_TextChanged"
                   BackgroundColor="{StaticResource MelSurface}"
                   TextColor="{StaticResource MelTexte}"
                   PlaceholderColor="{StaticResource MelTexteSecondaire}"
                   Placeholder="1950" />

            <Border BackgroundColor="{StaticResource MelSurface}"
                    Stroke="{StaticResource MelBordure}"
                    StrokeThickness="1"
                    Padding="16"
                    Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="16">
                    <Label Text="Prix de l'heure brut" VerticalOptions="Center"
                           TextColor="{StaticResource MelTexteSecondaire}" FontSize="13" />
                    <Label x:Name="TextePrixBrut" Grid.Column="1" Text="—"
                           TextColor="{StaticResource MelAccent}" FontAttributes="Bold"
                           HorizontalTextAlignment="End" />

                    <Label Grid.Row="1" Text="Prix de l'heure net" VerticalOptions="Center"
                           TextColor="{StaticResource MelTexteSecondaire}" FontSize="13" />
                    <Label x:Name="TextePrixNet" Grid.Row="1" Grid.Column="1" Text="—"
                           TextColor="{StaticResource MelAccent}" FontAttributes="Bold"
                           HorizontalTextAlignment="End" />

                    <Label Grid.Row="2" Text="Charges" VerticalOptions="Center"
                           TextColor="{StaticResource MelTexteSecondaire}" FontSize="13" />
                    <Label x:Name="TexteCharges" Grid.Row="2" Grid.Column="1" Text="—"
                           TextColor="{StaticResource MelErreur}" FontAttributes="Bold"
                           HorizontalTextAlignment="End" />
                </Grid>
            </Border>

            <Label x:Name="TexteEtat"
                   TextColor="{StaticResource MelTexteSecondaire}"
                   FontSize="12"
                   HorizontalTextAlignment="Center" />

            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,8,0,0">
                <Button Text="Fermer" WidthRequest="120" HeightRequest="46"
                        BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                        Clicked="Fermer_Clicked" />

                <Button Text="Enregistrer" WidthRequest="150" HeightRequest="46"
                        BackgroundColor="{StaticResource MelAccent}" TextColor="White"
                        FontAttributes="Bold"
                        Clicked="Enregistrer_Clicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
