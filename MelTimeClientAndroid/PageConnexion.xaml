<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageConnexion"
             BackgroundColor="{StaticResource MelFond}"
             Title="Connexion">

    <!-- Meme degrade que le reste de l'application : l'image de fond pesait
         trop visuellement derriere les champs. -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B4F7A" Offset="0.0" />
            <GradientStop Color="#123A56" Offset="0.45" />
            <GradientStop Color="#1B1B1B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <ScrollView BackgroundColor="Transparent">
            <VerticalStackLayout BackgroundColor="Transparent" Padding="32,32" Spacing="12">

            <!-- Identite de l'application, centree -->
            <Image Source="logo.png"
                   HeightRequest="110"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4" />

            <Label Text="MelTime"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="{StaticResource MelTexte}"
                   HorizontalOptions="Center" />

            <Label Text="Feuille de temps hebdomadaire"
                   FontSize="13"
                   TextColor="{StaticResource MelTexteSecondaire}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,24" />

            <Label Text="Serveur" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry x:Name="ChampHote"
                       Placeholder="IP ou domaine"
                       Keyboard="Url"
                       BackgroundColor="{StaticResource MelSurface}"
                       TextColor="{StaticResource MelTexte}"
                       PlaceholderColor="{StaticResource MelTexteSecondaire}" />

                <Label Grid.Column="1" Text=":" VerticalOptions="Center"
                       TextColor="{StaticResource MelTexteSecondaire}" />

                <Entry x:Name="ChampPort"
                       Grid.Column="2"
                       WidthRequest="90"
                       Keyboard="Numeric"
                       BackgroundColor="{StaticResource MelSurface}"
                       TextColor="{StaticResource MelTexte}"
                       PlaceholderColor="{StaticResource MelTexteSecondaire}" />
            </Grid>

            <Label Text="Identifiant" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />
            <Entry x:Name="ChampIdentifiant"
                   BackgroundColor="{StaticResource MelSurface}"
                   TextColor="{StaticResource MelTexte}"
                   PlaceholderColor="{StaticResource MelTexteSecondaire}" />

            <Label Text="Mot de passe" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />

            <!-- L'oeil occupe une colonne a droite du champ : le mot de passe
                 se devoile d'un appui, sans quitter la zone de saisie. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="ChampMotDePasse"
                       IsPassword="True"
                       BackgroundColor="{StaticResource MelSurface}"
                       TextColor="{StaticResource MelTexte}"
                       PlaceholderColor="{StaticResource MelTexteSecondaire}" />

                <!-- L'oeil est dessine, pas un emoji : Android impose sa propre
                     version coloree des emojis, insensible a TextColor. -->
                <Border x:Name="BoutonOeil"
                        Grid.Column="1"
                        WidthRequest="52"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource MelSurface}"
                        Stroke="{StaticResource MelSurface}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="BoutonOeil_Tapped" />
                    </Border.GestureRecognizers>

                    <Grid WidthRequest="27" HeightRequest="27"
                          HorizontalOptions="Center" VerticalOptions="Center">

                        <Path x:Name="OeilContour"
                              Data="M 2,12 C 5,6.5 8.5,4.5 12,4.5 C 15.5,4.5 19,6.5 22,12 C 19,17.5 15.5,19.5 12,19.5 C 8.5,19.5 5,17.5 2,12 Z"
                              Stroke="#A0A0A0"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              Aspect="Uniform" />

                        <Path x:Name="OeilPupille"
                              Data="M 12,8.6 A 3.4,3.4 0 1,1 11.9,8.6 Z"
                              Stroke="#A0A0A0"
                              StrokeThickness="1.6"
                              Fill="Transparent"
                              Aspect="Uniform" />

                        <!-- Barre diagonale : l'oeil est barre tant que le texte est masque. -->
                        <Path x:Name="OeilBarre"
                              Data="M 4,3.5 L 20,20.5"
                              Stroke="#A0A0A0"
                              StrokeThickness="1.8"
                              Aspect="Uniform" />
                    </Grid>
                </Border>
            </Grid>

            <HorizontalStackLayout x:Name="ZoneBiometrie" Spacing="6" Margin="0,4,0,0">
                <CheckBox x:Name="CaseBiometrie" Color="{StaticResource MelAccent}"
                          CheckedChanged="CaseBiometrie_Changed" />
                <Label Text="Connexion par empreinte"
                       FontSize="13"
                       TextColor="{StaticResource MelTexteSecondaire}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="TexteErreur"
                   IsVisible="False"
                   TextColor="{StaticResource MelErreur}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />

            <Button x:Name="BoutonConnexion"
                    Text="Se connecter"
                    HeightRequest="52"
                    Margin="0,8,0,0"
                    BackgroundColor="{StaticResource MelAccent}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="BoutonConnexion_Clicked" />

            <Button x:Name="BoutonEmpreinte"
                    Text="Connexion par empreinte"
                    IsVisible="False"
                    HeightRequest="52"
                    Margin="0,8,0,0"
                    BackgroundColor="{StaticResource MelAccent}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="BoutonEmpreinte_Clicked" />

        </VerticalStackLayout>
            </ScrollView>

    </Grid>

</ContentPage>
