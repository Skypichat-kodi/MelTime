<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageConnexion"
             BackgroundColor="{StaticResource MelFond}"
             Title="Connexion">

    <!-- L'image est un vrai controle, place au fond d'une grille. La propriete
         BackgroundImageSource de la page ne s'affichait pas sur Android.
         Les conteneurs sont explicitement transparents : leur couleur par
         defaut recouvrait l'image d'un aplat gris. -->
    <Grid>

        <Image Source="background.png"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ScrollView BackgroundColor="Transparent">
            <VerticalStackLayout BackgroundColor="Transparent" Padding="32,32" Spacing="12">

            <!-- Identite de l'application, centree -->
            <Image Source="logo.png"
                   HeightRequest="110"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4" />

            <Label Text="MelTime"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="{StaticResource MelTexte}"
                   HorizontalOptions="Center" />

            <Label Text="Feuille de temps hebdomadaire"
                   FontSize="13"
                   TextColor="{StaticResource MelTexteSecondaire}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,24" />

            <Label Text="Serveur" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry x:Name="ChampHote"
                       Placeholder="192.168.1.19"
                       Keyboard="Url"
                       BackgroundColor="{StaticResource MelSurface}"
                       TextColor="{StaticResource MelTexte}"
                       PlaceholderColor="{StaticResource MelTexteSecondaire}" />

                <Label Grid.Column="1" Text=":" VerticalOptions="Center"
                       TextColor="{StaticResource MelTexteSecondaire}" />

                <Entry x:Name="ChampPort"
                       Grid.Column="2"
                       WidthRequest="90"
                       Keyboard="Numeric"
                       BackgroundColor="{StaticResource MelSurface}"
                       TextColor="{StaticResource MelTexte}"
                       PlaceholderColor="{StaticResource MelTexteSecondaire}" />
            </Grid>

            <Label Text="Identifiant" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />
            <Entry x:Name="ChampIdentifiant"
                   BackgroundColor="{StaticResource MelSurface}"
                   TextColor="{StaticResource MelTexte}"
                   PlaceholderColor="{StaticResource MelTexteSecondaire}" />

            <Label Text="Mot de passe" TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />
            <Entry x:Name="ChampMotDePasse"
                   IsPassword="True"
                   BackgroundColor="{StaticResource MelSurface}"
                   TextColor="{StaticResource MelTexte}"
                   PlaceholderColor="{StaticResource MelTexteSecondaire}" />

            <HorizontalStackLayout x:Name="ZoneBiometrie" Spacing="6" Margin="0,4,0,0">
                <CheckBox x:Name="CaseBiometrie" Color="{StaticResource MelAccent}" />
                <Label Text="Connexion par empreinte"
                       FontSize="13"
                       TextColor="{StaticResource MelTexteSecondaire}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label x:Name="TexteErreur"
                   IsVisible="False"
                   TextColor="{StaticResource MelErreur}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />

            <Button x:Name="BoutonConnexion"
                    Text="Se connecter"
                    HeightRequest="52"
                    Margin="0,8,0,0"
                    BackgroundColor="{StaticResource MelAccent}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="BoutonConnexion_Clicked" />

            <Button x:Name="BoutonEmpreinte"
                    Text="Connexion par empreinte"
                    IsVisible="False"
                    HeightRequest="48"
                    BackgroundColor="{StaticResource MelSurface}"
                    BorderColor="{StaticResource MelAccent}"
                    BorderWidth="1"
                    TextColor="{StaticResource MelAccent}"
                    CornerRadius="8"
                    Clicked="BoutonEmpreinte_Clicked" />

        </VerticalStackLayout>
            </ScrollView>

    </Grid>

</ContentPage>
