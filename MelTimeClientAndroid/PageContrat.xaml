<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageContrat"
             BackgroundColor="{StaticResource MelFond}">

    <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

        <Label Text="Contrat hebdomadaire"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource MelTexte}"
               HorizontalOptions="Center" />

        <Label Text="Durée prévue par semaine. Elle sert au calcul des heures supplémentaires et des manques."
               FontSize="12"
               TextColor="{StaticResource MelTexteSecondaire}"
               HorizontalTextAlignment="Center" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
            <Picker x:Name="ChoixHeures" WidthRequest="100"
                    BackgroundColor="{StaticResource MelSurface}"
                    TextColor="{StaticResource MelTexte}" />

            <Label Text="h" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" FontSize="16" />

            <Picker x:Name="ChoixMinutes" WidthRequest="100"
                    BackgroundColor="{StaticResource MelSurface}"
                    TextColor="{StaticResource MelTexte}" />

            <Label Text="min" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" FontSize="16" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,14,0,0">
            <Button Text="Annuler" WidthRequest="130" HeightRequest="46"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="Annuler_Clicked" />

            <Button Text="Valider" WidthRequest="130" HeightRequest="46"
                    BackgroundColor="{StaticResource MelAccent}" TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Valider_Clicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>
