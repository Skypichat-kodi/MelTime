<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageContrat"
             BackgroundColor="{StaticResource MelFond}">

    <!-- Degrade du bleu vers le noir : la page se distingue de la feuille
         de temps sans rompre l'habillage. -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B4F7A" Offset="0.0" />
            <GradientStop Color="#123A56" Offset="0.45" />
            <GradientStop Color="#1B1B1B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Padding="20,12" Spacing="10"
                         HorizontalOptions="Center" VerticalOptions="Center">

        <Label Text="Contrat hebdomadaire"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{StaticResource MelTexte}"
               HorizontalOptions="Center" />

        <Label Text="Durée prévue par semaine. Elle sert au calcul des heures supplémentaires et des manques."
               FontSize="12"
               TextColor="{StaticResource MelTexteSecondaire}"
               HorizontalTextAlignment="Center" />

        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
            <Picker x:Name="ChoixHeures" WidthRequest="100"
                    BackgroundColor="{StaticResource MelSurface}"
                    TextColor="{StaticResource MelTexte}" />

            <Label Text="h" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" FontSize="16" />

            <Picker x:Name="ChoixMinutes" WidthRequest="100"
                    BackgroundColor="{StaticResource MelSurface}"
                    TextColor="{StaticResource MelTexte}" />

            <Label Text="min" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" FontSize="16" />
        </HorizontalStackLayout>

        <!-- Date d'arrivee : les semaines anterieures ne comptent pas dans
             le solde, elles ne doivent donc pas creer de manque. -->
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
            <Label Text="Début de contrat" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexteSecondaire}" FontSize="13" />

            <DatePicker x:Name="ChampDebut" Format="dd/MM/yyyy" WidthRequest="150"
                        TextColor="{StaticResource MelTexte}"
                        BackgroundColor="{StaticResource MelSurface}" />

            <Button Text="Effacer" WidthRequest="90" HeightRequest="38"
                    BackgroundColor="{StaticResource MelBleuNuit}" TextColor="{StaticResource MelTexte}"
                    Clicked="EffacerDebut_Clicked" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,14,0,0">
            <Button Text="Annuler" WidthRequest="130" HeightRequest="46"
                    BackgroundColor="{StaticResource MelBleuNuit}" TextColor="{StaticResource MelTexte}"
                    Clicked="Annuler_Clicked" />

            <Button Text="Valider" WidthRequest="130" HeightRequest="46"
                    BackgroundColor="{StaticResource MelAccent}" TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Valider_Clicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>
