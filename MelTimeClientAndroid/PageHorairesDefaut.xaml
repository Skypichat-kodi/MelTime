<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageHorairesDefaut"
             BackgroundColor="{StaticResource MelFond}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Calendriers par défaut"
                   FontSize="20" FontAttributes="Bold"
                   TextColor="{StaticResource MelTexte}" />

            <Label Text="Cinq modèles possibles, qui alternent selon la semaine. Ils préremplissent les semaines jamais saisies."
                   FontSize="12"
                   TextColor="{StaticResource MelTexteSecondaire}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="8">

            <!-- Point de depart du cycle -->
            <HorizontalStackLayout Spacing="8">
                <Label Text="Début du cycle" VerticalOptions="Center" FontSize="13"
                       TextColor="{StaticResource MelTexteSecondaire}" />

                <Picker x:Name="ChoixAnnee" WidthRequest="96"
                        BackgroundColor="{StaticResource MelSurface}"
                        TextColor="{StaticResource MelTexte}" />

                <Picker x:Name="ChoixSemaine" WidthRequest="112"
                        BackgroundColor="{StaticResource MelSurface}"
                        TextColor="{StaticResource MelTexte}" />
            </HorizontalStackLayout>

            <!-- Choix du modele : un bouton par lettre -->
            <HorizontalStackLayout x:Name="ZoneLettres" Spacing="6" />

            <HorizontalStackLayout Spacing="6">
                <CheckBox x:Name="CaseActif" CheckedChanged="CaseActif_Changed"
                          Color="{StaticResource MelAccent}" />
                <Label Text="Ce modèle participe à la rotation"
                       FontSize="13" VerticalOptions="Center"
                       TextColor="{StaticResource MelTexteSecondaire}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <Grid x:Name="ZoneJours" />
        </ScrollView>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Label x:Name="TexteEtat" VerticalOptions="Center" FontSize="12"
                   TextColor="{StaticResource MelTexteSecondaire}" />

            <Button Grid.Column="1" Text="Fermer" WidthRequest="110" HeightRequest="44"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="Fermer_Clicked" />

            <Button Grid.Column="2" Text="Enregistrer" WidthRequest="140" HeightRequest="44"
                    BackgroundColor="{StaticResource MelAccent}" TextColor="White"
                    FontAttributes="Bold"
                    Clicked="Enregistrer_Clicked" />
        </Grid>

    </Grid>

</ContentPage>
