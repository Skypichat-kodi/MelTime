<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageFeuilleTemps"
             BackgroundColor="{StaticResource MelFond}">

    <!-- Degrade du bleu vers le noir, comme toutes les pages de l'application. -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B4F7A" Offset="0.0" />
            <GradientStop Color="#123A56" Offset="0.45" />
            <GradientStop Color="#1B1B1B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto" Padding="8" RowSpacing="6">

        <!-- Navigation entre les semaines, et total de la semaine -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <!-- Les deux fleches et le libelle forment un seul bloc : l'encadre
                 sombre fait la liaison entre les boutons. -->
            <HorizontalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                <Button x:Name="BoutonPrecedent" Text="◀" WidthRequest="44" HeightRequest="38"
                        BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                        Clicked="BoutonPrecedent_Clicked" />

                <Border BackgroundColor="#141414" Stroke="#141414" StrokeThickness="0"
                        Padding="14,0">
                    <Label x:Name="TexteSemaine" VerticalOptions="Center"
                           TextColor="{StaticResource MelTexte}" FontAttributes="Bold" FontSize="14" />
                </Border>

                <Button x:Name="BoutonSuivant" Text="▶" WidthRequest="44" HeightRequest="38"
                        BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                        Clicked="BoutonSuivant_Clicked" />
            </HorizontalStackLayout>

            <Button x:Name="BoutonAujourdhui" Grid.Column="1" Text="Aujourd'hui" HeightRequest="38"
                    Padding="12,0"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonAujourdhui_Clicked" />

            <Label x:Name="TexteStatut" Grid.Column="2" VerticalOptions="Center" HorizontalTextAlignment="End"
                   TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />

            <!-- Total de la semaine, mis en avant dans son cadre -->
            <Border Grid.Column="3"
                    BackgroundColor="{StaticResource MelSurface}"
                    Stroke="{StaticResource MelAccent}" StrokeThickness="1.5"
                    Padding="16,4">
                <Label x:Name="TexteTotalSemaine" Text="—"
                       FontSize="26" FontAttributes="Bold"
                       TextColor="{StaticResource MelAccent}"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Grille des sept jours, construite par le code -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource MelSurface}"
                Stroke="{StaticResource MelBordure}" StrokeThickness="1">
            <Grid x:Name="GrilleJours" />
        </Border>

        <!-- Acces aux pages de reglage, et sortie -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="8">
            <Button x:Name="BoutonContrat" Grid.Column="0" Text="Mon contrat"
                    HeightRequest="44" FontSize="13"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonContrat_Clicked" />

            <Button x:Name="BoutonCalendriers" Grid.Column="1" Text="Cal/défaut"
                    HeightRequest="44" FontSize="13"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonDefauts_Clicked" />

            <Button x:Name="BoutonSalaire" Grid.Column="2" Text="Mon salaire"
                    HeightRequest="44" FontSize="13"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonReglages_Clicked" />

            <Button x:Name="BoutonStats" Grid.Column="3" Text="Statistiques"
                    HeightRequest="44" FontSize="13"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonStats_Clicked" />

            <Button x:Name="BoutonDeconnexion" Grid.Column="4" Text="Quitter"
                    HeightRequest="44" Padding="16,0"
                    BackgroundColor="{StaticResource MelErreur}" TextColor="White"
                    Clicked="BoutonDeconnexion_Clicked" />
        </Grid>

    </Grid>

</ContentPage>
