<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageFeuilleTemps"
             BackgroundColor="{StaticResource MelFond}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="8" RowSpacing="6">

        <!-- Navigation entre les semaines -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <Button x:Name="BoutonPrecedent" Text="◀" WidthRequest="44" HeightRequest="38"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonPrecedent_Clicked" />

            <Label x:Name="TexteSemaine" Grid.Column="1" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexte}" FontAttributes="Bold" FontSize="14" />

            <Button x:Name="BoutonSuivant" Grid.Column="2" Text="▶" WidthRequest="44" HeightRequest="38"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonSuivant_Clicked" />

            <Button x:Name="BoutonAujourdhui" Grid.Column="3" Text="Aujourd'hui" HeightRequest="38"
                    Margin="6,0,0,0" Padding="12,0"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonAujourdhui_Clicked" />

            <Label x:Name="TexteStatut" Grid.Column="5" VerticalOptions="Center" HorizontalTextAlignment="End"
                   TextColor="{StaticResource MelTexteSecondaire}" FontSize="12" />

            <Button x:Name="BoutonDefauts" Grid.Column="6" Text="Défauts" HeightRequest="38"
                    Margin="0,0,6,0" Padding="10,0"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonDefauts_Clicked" />

            <Button x:Name="BoutonReglages" Grid.Column="7" Text="⚙" WidthRequest="44" HeightRequest="38"
                    Margin="0,0,6,0" FontSize="18"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="BoutonReglages_Clicked" />

            <Button x:Name="BoutonDeconnexion" Grid.Column="8" Text="Quitter" HeightRequest="38"
                    Padding="12,0"
                    BackgroundColor="{StaticResource MelErreur}" TextColor="White"
                    Clicked="BoutonDeconnexion_Clicked" />
        </Grid>

        <!-- Grille des sept jours, construite par le code -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource MelSurface}"
                Stroke="{StaticResource MelBordure}" StrokeThickness="1">
            <Grid x:Name="GrilleJours" />
        </Border>

        <!-- Totaux -->
        <HorizontalStackLayout Grid.Row="2" Spacing="16">
            <!-- Contrat de la semaine : un appui permet de le modifier. -->
            <Label x:Name="TexteContrat" FontSize="14" VerticalOptions="Center"
                   TextColor="{StaticResource MelTexteSecondaire}"
                   TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TexteContrat_Tapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label x:Name="TexteTotal" TextColor="{StaticResource MelAccent}"
                   FontAttributes="Bold" FontSize="16" />
            <Label x:Name="TexteEcart" FontSize="14" VerticalOptions="Center" />
            <Label x:Name="TexteTotalMois" TextColor="{StaticResource MelTexteSecondaire}"
                   FontSize="14" VerticalOptions="Center" />
            <Label x:Name="TexteSolde" TextColor="{StaticResource MelTexteSecondaire}"
                   FontSize="14" VerticalOptions="Center" />
            <Label x:Name="TexteSupplementairesAn" TextColor="{StaticResource MelTexteSecondaire}"
                   FontSize="14" VerticalOptions="Center" />
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
