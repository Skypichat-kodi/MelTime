<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MelTimeClientAndroid.PageStats"
             BackgroundColor="{StaticResource MelFond}">

    <!-- Degrade du bleu vers le noir, comme les autres pages de reglage. -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0B4F7A" Offset="0.0" />
            <GradientStop Color="#123A56" Offset="0.45" />
            <GradientStop Color="#1B1B1B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="24" RowDefinitions="Auto,*,Auto" RowSpacing="14">

        <Label Grid.Row="0" Text="Statistiques"
               FontSize="22" FontAttributes="Bold"
               TextColor="{StaticResource MelTexte}" />

        <!-- Tableau des heures, sur trois periodes -->
        <Border Grid.Row="1" VerticalOptions="Start"
                BackgroundColor="{StaticResource MelSurface}"
                Stroke="{StaticResource MelBordure}" StrokeThickness="1">
            <Grid x:Name="Tableau" />
        </Border>

        <!-- Le bouton occupe sa propre rangee, sous le tableau -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Text="Fermer" WidthRequest="140" HeightRequest="44"
                    BackgroundColor="{StaticResource MelSurface}" TextColor="{StaticResource MelTexte}"
                    Clicked="Fermer_Clicked" />
        </Grid>

    </Grid>

</ContentPage>
