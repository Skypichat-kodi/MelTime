<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>MelTime.Tray</RootNamespace>
    <AssemblyName>MelTime.Tray</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icones de la zone de notification, dessinees par l'utilisateur. -->
    <EmbeddedResource Include="Resources\Icons\tray-vert.ico" />
    <EmbeddedResource Include="Resources\Icons\tray-rouge.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MelTime.Core\MelTime.Core.csproj" />
  </ItemGroup>

</Project>
